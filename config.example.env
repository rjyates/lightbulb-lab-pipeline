# Copy to config.env (never commit config.env):  cp config.example.env config.env

# --- Narration: kokoro (free, offline, default) or elevenlabs ---
LBL_VOICE=kokoro
# Kip's voice: Kokoro voices blended by weight (python tools/voice_samples.py renders candidates), and speed
KOKORO_VOICE=af_heart:0.4,am_michael:0.6
KOKORO_SPEED=0.97

# --- ElevenLabs (only with LBL_VOICE=elevenlabs; the free plan is not licensed for commercial use) ---
# Profile icon > API Keys > Create. Give the key "Text to Speech" + "User: read" access.
ELEVENLABS_API_KEY=
# Voices > Kip > "..." > Copy voice ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_SPEED=1.0

# --- YouTube (until Google approves the API audit, API uploads stay private even when scheduled) ---
YOUTUBE_UPLOAD=false
YOUTUBE_PRIVACY=private
# python3 -m lightbulb.youtube playlists   -> copy the Tech from Scratch playlist ID
YOUTUBE_PLAYLIST_ID=

# --- Phone ping on failures (free): install the "ntfy" app and subscribe to this topic.
# Pick something long and unguessable; anyone who knows the name can read it.
NTFY_TOPIC=

# --- Worker (python -m lightbulb.worker) ---
# Private ops repo checkout: the worker pulls it before each run and commits the queue and ledger after.
# LBL_OPS_REPO=/home/you/lightbulb-lab-ops
# LBL_QUEUE=/home/you/lightbulb-lab-ops/ledger/queue.json
# Upload record that prevents duplicate uploads (default: <LBL_OUTPUT>/ledger/videos.jsonl). Keep it; deleting it re-enables uploads.
# LBL_LEDGER=/home/you/lightbulb-lab-ops/ledger/videos.jsonl
# How far ahead to keep videos scheduled, and the calendar's time zone
# LBL_BUFFER_DAYS=21
# LBL_TZ=America/Chicago

# --- Optional ---
# LBL_OUTPUT=/home/you/lightbulb-videos
# LBL_WORKERS=4
