[Unit]
Description=Lightbulb Lab weekly episode
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
ExecStartPre=-/usr/bin/git -C __DIR__ pull --ff-only
ExecStart=__DIR__/.venv/bin/python -m lightbulb.weekly
Nice=10
TimeoutStartSec=6h
